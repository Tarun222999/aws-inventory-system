{
  "name": "@order-platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "migrate:run": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "phase5:lab": "tsx src/phase5-lab.ts",
    "phase5:rotation": "tsx src/phase5-rotation-lab.ts",
    "phase5:s3": "tsx src/phase5-s3-lab.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "test": "tsx --test src/modules/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@order-platform/config": "0.1.0",
    "@order-platform/database": "0.1.0",
    "@order-platform/logger": "0.1.0",
    "drizzle-orm": "0.45.2",
    "zod": "3.25.76"
  }
}
